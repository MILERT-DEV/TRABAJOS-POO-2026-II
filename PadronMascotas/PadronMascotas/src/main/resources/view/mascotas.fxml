<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.mascotas.controller.MascotaController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>

   <top>
      <Label text="Padrón de Animales Domésticos">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
         <padding>
            <Insets bottom="10.0" />
         </padding>
      </Label>
   </top>

   <left>
      <VBox prefWidth="320.0" spacing="8.0">
         <padding>
            <Insets right="12.0" />
         </padding>
         <children>
            <Label text="Datos de la mascota">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <GridPane hgap="8.0" vgap="8.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="90.0" prefWidth="90.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <children>
                  <Label text="Nombre" GridPane.rowIndex="0" />
                  <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                  <Label text="Especie" GridPane.rowIndex="1" />
                  <ComboBox fx:id="cbxEspecie" maxWidth="1.7976931348623157E308" promptText="Seleccione" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                  <Label text="Raza" GridPane.rowIndex="2" />
                  <TextField fx:id="txtRaza" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                  <Label text="Color" GridPane.rowIndex="4" />
                  <ComboBox fx:id="cbxColor" maxWidth="1.7976931348623157E308" promptText="Seleccione" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                  <Label text="Edad (años)" GridPane.rowIndex="6" />
                  <TextField fx:id="txtEdad" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                  <Label text="Propietario" GridPane.rowIndex="8" />
                  <TextField fx:id="txtPropietario" GridPane.columnIndex="1" GridPane.rowIndex="8" />

                  <Label prefHeight="0.0" prefWidth="69.0" text="Teléfono" GridPane.rowIndex="9" />
                  <TextField fx:id="txtTelefono" promptText="9 dígitos" GridPane.columnIndex="1" GridPane.rowIndex="9" />

                  <Label text="Vacunación" GridPane.rowIndex="7" />
                  <ComboBox fx:id="cbxVacunacion" maxWidth="1.7976931348623157E308" promptText="Seleccione" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                  <Label text="Sexo" GridPane.rowIndex="3" />
                  <ComboBox fx:id="cbxSexo" maxWidth="1.7976931348623157E308" promptText="Seleccione" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               </children>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints maxHeight="0.0" minHeight="0.0" prefHeight="0.0" />
                  <RowConstraints maxHeight="0.0" minHeight="0.0" prefHeight="0.0" />
               </rowConstraints>
            </GridPane>
            <HBox spacing="8.0">
               <children>
                  <Button fx:id="btnGuardar" onAction="#onGuardar" prefWidth="90.0" text="Guardar" />
                  <Button onAction="#onNuevo" prefWidth="90.0" text="Nuevo" />
                  <Button fx:id="btnEliminar" onAction="#onEliminar" prefWidth="90.0" text="Eliminar" />
               </children>
            </HBox>
            <Label fx:id="lblMensaje" maxWidth="300.0" wrapText="true" />
         </children>
      </VBox>
   </left>

   <center>
      <VBox spacing="8.0">
         <children>
            <HBox spacing="8.0">
               <children>
                  <Label text="Filtrar por especie:" />
                  <ComboBox fx:id="cbxFiltroEspecie" onAction="#onFiltrar" prefWidth="110.0" />
                  <Label text="Vacunación:" />
                  <ComboBox fx:id="cbxFiltroVacunacion" onAction="#onFiltrar" prefWidth="110.0" />
               </children>
            </HBox>
            <TableView fx:id="tablaMascotas" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
                  <TableColumn fx:id="colNombre" prefWidth="100.0" text="Nombre" />
                  <TableColumn fx:id="colEspecie" prefWidth="70.0" text="Especie" />
                  <TableColumn fx:id="colRaza" prefWidth="90.0" text="Raza" />
                  <TableColumn fx:id="colColor" prefWidth="80.0" text="Color" />
                  <TableColumn fx:id="colSexo" prefWidth="60.0" text="Sexo" />
                  <TableColumn fx:id="colEdad" prefWidth="50.0" text="Edad" />
                  <TableColumn fx:id="colPropietario" prefWidth="120.0" text="Propietario" />
                  <TableColumn fx:id="colTelefono" prefWidth="90.0" text="Teléfono" />
                  <TableColumn fx:id="colVacunacion" prefWidth="90.0" text="Vacunación" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
